<div class="container mt-5">
  <div class="p-5 rounded"
       style="background-color: #f8f9fa; box-shadow: 0 4px 10px rgba(0,0,0,0.2);">

    <h1 class="display-4">
      <%= @detail.first_name %> <%= @detail.last_name %>
    </h1>

    <p class="lead">
      <%= @detail.email %> |
      <%= @detail.contact %> |
      <%= @detail.twitter %>
    </p>

    <br>

    <%= link_to "Edit this detail",
        edit_detail_path(@detail),
        class: "btn btn-secondary btn-lg" %>

    <%= link_to "Back to details",
        details_path,
        class: "btn btn-dark btn-lg" %>

    <hr>

    <%= button_to "Destroy this detail",
        @detail,
        method: :delete,
        class: "btn btn-danger" %>

  </div>
</div>

